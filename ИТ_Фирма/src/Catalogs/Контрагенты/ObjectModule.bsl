			Отказ = Истина;
			
			Сообщить("Контрольная проверка не пройдена");
			
		КонецЕсли;	
		
		Если Не ЗначениеЗаполнено(КПП) 
			
			Или ДлинаКПП <>9 Тогда
			
			Отказ = Истина;
			
			Сообщить("Необходимо заполнить КПП, его длина должна быть 9 символов");	
			
		ИначеЕсли Не ТолькоЦифрыВСтроке1(КПП) Тогда 
			
			Отказ = Истина;
			
			Сообщить("КПП должен состоять только из цифр");
			
		КонецЕсли;	
		
		
	Иначе 
		
		Если ДлинаИНН <> 12 Или Не ЗначениеЗаполнено(ИНН) Тогда 
			
			Отказ = Истина;	
			
			Сообщить ("Значение ИНН должно быть заполнено и иметь длину 12 символов");
			
		ИначеЕсли Не ТолькоЦифрыВСтроке(ИНН) Тогда
			
			Отказ = Истина;
			
			Сообщить("ИНН должен состоять только из цифр");
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КПП) Тогда
			
			Отказ = Истина;	
			
			Сообщить("Поле КПП должно быть пустым");
			
		КонецЕсли;	
		
	КонецЕсли;
		
