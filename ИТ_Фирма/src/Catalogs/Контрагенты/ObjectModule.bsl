Функция ТолькоЦифрыВСтроке(ИНН) 
	
	Цифры = "0123456789";
	
	Для СчИНН = 1 По СтрДлина(ИНН) Цикл
		
		Символ = Сред(ИНН, СчИНН, 1);
		
		Если СтрНайти(Цифры, Символ) = 0 Тогда 
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции
Функция ТолькоЦифрыВСтроке1(КПП)
	
	Цифры = "0123456789";
	
	Для СчКПП = 1 По СтрДлина(КПП) Цикл
		
		Символ = Сред(КПП, СчКПП, 1);
		
		Если СтрНайти(Цифры, Символ) = 0 Тогда 
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции


