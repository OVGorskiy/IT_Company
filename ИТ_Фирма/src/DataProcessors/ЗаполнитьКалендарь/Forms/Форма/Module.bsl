
&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Переменная = Период.ДатаНачала;
	
	Пока Переменная < Период.ДатаОкончания Цикл
		
		Запись = РегистрыСведений.Календарь.СоздатьМенеджерЗаписи();
		Запись.Дата = Переменная;
		Если ДеньНедели(Переменная) <= 5 Тогда
			Запись.РабочихДней = 1;
		КонецЕсли;
		
		Запись.Записать();
		Переменная = Переменная + 86400;
		
	КонецЦикла;	
	
КонецПроцедуры
